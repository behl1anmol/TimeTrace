<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:timetrace.ui.avalonia.ViewModels"
             xmlns:controls="using:timetrace.ui.avalonia.Controls"
             xmlns:views="using:timetrace.ui.avalonia.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="timetrace.ui.avalonia.Views.ApplicationListView"
             x:DataType="vm:ApplicationListViewModel">

    <Design.DataContext>
        <vm:ApplicationListViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- HEADER -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,32">
            <StackPanel>
                <TextBlock Text="Currently Running Applications" 
                           Classes="heading1"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Click on any application to view captured screenshots"
                           Classes="body muted"
                           Margin="0,6,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding RefreshCommand}"
                    Classes="secondary"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource CardBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 0 0-8 8 8 8 0 0 0 8 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18a6 6 0 0 1-6-6 6 6 0 0 1 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Text="Refresh" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- LOADING STATE -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <controls:BusyIndicator Grid.Row="1"
                                IsActive="{Binding IsLoading}"
                                Message="Loading applications..."
                                IsVisible="{Binding IsLoading}"/>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- EMPTY STATE -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Viewbox Width="64" Height="64" Opacity="0.4">
                    <Path Data="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v12h16V6H4z"
                          Fill="{DynamicResource TextMutedBrush}"
                          Stretch="Uniform"/>
                </Viewbox>
                <TextBlock Text="No applications found"
                           Classes="heading2"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Start running some applications to see them here"
                           Classes="body muted"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- ERROR STATE -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource StatusErrorBackgroundBrush}"
                CornerRadius="12"
                Padding="32">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <Viewbox Width="40" Height="40">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                          Fill="{StaticResource StatusErrorBrush}"
                          Stretch="Uniform"/>
                </Viewbox>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource StatusErrorBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Center"/>
                <Button Content="Retry" 
                        Command="{Binding RefreshCommand}"
                        Classes="primary"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- APPLICATION CARDS GRID -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding !IsLoading}">
            <ItemsControl ItemsSource="{Binding Applications}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ApplicationItemViewModel">
                        <views:ApplicationItemView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
