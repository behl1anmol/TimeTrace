<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:timetrace.ui.avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="400"
             x:Class="timetrace.ui.avalonia.Views.FilterView"
             x:DataType="vm:FilterViewModel">

    <Design.DataContext>
        <vm:FilterViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource FilterPanelBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid RowDefinitions="*,Auto">
            
            <!-- Filter Controls -->
            <StackPanel Grid.Row="0" Spacing="20" Margin="20">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M19 4H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM9 16H7v-2h2v2zm0-4H7V8h2v4zm4 4h-2v-4h2v4zm0-6h-2V8h2v2zm4 6h-4v-2h4v2zm0-4h-4V8h4v4z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Text="Date Filter" 
                               Classes="heading3"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- From Date -->
                <StackPanel Spacing="6">
                    <TextBlock Text="FROM"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}"
                               LetterSpacing="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <CalendarDatePicker SelectedDate="{Binding FromDate}"
                                            HorizontalAlignment="Stretch"
                                            Watermark="Pick start date..."
                                            CornerRadius="8"/>
                        <Button Grid.Column="1"
                                Command="{Binding ClearFromDateCommand}"
                                IsVisible="{Binding FromDate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Classes="ghost"
                                Margin="4,0,0,0"
                                Width="32" Height="32">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- To Date -->
                <StackPanel Spacing="6">
                    <TextBlock Text="TO"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMutedBrush}"
                               LetterSpacing="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <CalendarDatePicker SelectedDate="{Binding ToDate}"
                                            HorizontalAlignment="Stretch"
                                            Watermark="Pick end date..."
                                            CornerRadius="8"/>
                        <Button Grid.Column="1"
                                Command="{Binding ClearToDateCommand}"
                                IsVisible="{Binding ToDate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Classes="ghost"
                                Margin="4,0,0,0"
                                Width="32" Height="32">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Active Filter Summary -->
                <Border Background="{StaticResource AccentPrimaryLightBrush}"
                        BorderBrush="{StaticResource AccentPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        IsVisible="{Binding HasActiveFilter}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding FilterSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Clear Filters Button -->
                <Button Command="{Binding ClearAllCommand}"
                        IsVisible="{Binding HasActiveFilter}"
                        Classes="secondary"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource CardBorderBrush}">
                    <TextBlock Text="Clear Filters" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
            
            <!-- Stats Footer -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,16"
                    CornerRadius="0,0,12,12">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Total"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalCount, StringFormat='{}{0} screenshots'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Filtered"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FilteredCount, StringFormat='{}{0} results'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</UserControl>
