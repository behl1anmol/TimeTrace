<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:timetrace.ui.avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="220"
             x:Class="timetrace.ui.avalonia.Views.ApplicationItemView"
             x:DataType="vm:ApplicationItemViewModel">

    <Button Command="{Binding SelectCommand}"
            CommandParameter="{Binding}"
            Margin="0,0,20,20"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
        <Border Width="340"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Border.Transitions>
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Border.Transitions>

            <Grid RowDefinitions="Auto,Auto,16,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Width="48"
                            Height="48"
                            CornerRadius="10"
                            Background="{StaticResource AccentPrimaryLightBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="{Binding Icon}"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProcessName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="2"
                            Classes="statusBadge"
                            Classes.running="{Binding IsRunning}"
                            Classes.idle="{Binding !IsRunning}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Viewbox Width="10" Height="10">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                                      Stretch="Uniform">
                                    <Path.Fill>
                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                    </Path.Fill>
                                </Path>
                            </Viewbox>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Viewbox Grid.Column="3" Width="20" Height="20" Margin="12,0,0,0" Opacity="0.4">
                        <Path Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                              Fill="{DynamicResource TextMutedBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>
                </Grid>

                <Border Grid.Row="2"
                        Height="1"
                        Background="{DynamicResource DividerBrush}"
                        Margin="0"/>

                <Grid Grid.Row="3" ColumnDefinitions="*,*">
                    <StackPanel>
                        <TextBlock Text="Memory Usage"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding MemoryUsage}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Screenshots"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Viewbox Width="18" Height="18" Opacity="0.7">
                                <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Text="{Binding ScreenshotCount}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Button>

</UserControl>

