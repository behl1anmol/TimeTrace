<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:timetrace.ui.avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="timetrace.ui.avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="800">
            
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- HEADER -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <StackPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="28" Height="28">
                        <Path Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              Stretch="Uniform"/>
                    </Viewbox>
                    <TextBlock Text="Settings" 
                               Classes="heading1"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Configure application capture and monitoring preferences"
                           Classes="body muted"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- CAPTURE SETTINGS SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="20">
                    <!-- Section Header -->
                    <StackPanel>
                        <TextBlock Text="Capture Settings" 
                                   Classes="heading2"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Configure how and when screenshots are captured"
                                   Classes="caption"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Auto Capture Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Automatic Capture" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Automatically capture screenshots at regular intervals"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding AutoCaptureEnabled}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    
                    <!-- Capture Interval -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoCaptureEnabled}">
                        <StackPanel>
                            <TextBlock Text="Capture Interval (minutes)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding CaptureIntervalSeconds}"
                                       Minimum="1"
                                       Maximum="60"
                                       Width="120"
                                       Increment="1"
                                       CornerRadius="8"/>
                    </Grid>
                    
                    <!-- Screenshot Quality -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Screenshot Quality"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding ScreenshotQuality}"
                                  Width="160"
                                  CornerRadius="8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- MONITORING SETTINGS SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="20">
                    <!-- Section Header -->
                    <StackPanel>
                        <TextBlock Text="Monitoring Settings" 
                                   Classes="heading2"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Choose which applications to monitor"
                                   Classes="caption"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Monitor All Applications"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Track all running applications on this system"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding MonitorAllApps}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Include Background Apps"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Monitor applications running in the background"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding IncludeBackgroundApps}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Include System Apps"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Monitor system applications"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding IncludeSystemApps}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- STORAGE SETTINGS SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="20">
                    <!-- Section Header -->
                    <StackPanel>
                        <TextBlock Text="Storage Settings" 
                                   Classes="heading2"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Manage screenshot storage and retention"
                                   Classes="caption"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Storage Path -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage Location"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding StoragePath}"
                                     IsReadOnly="True"
                                     CornerRadius="8"/>
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Command="{Binding BrowseStoragePathCommand}"
                                    Classes="secondary"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Retention Days -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Retention Period (days)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Screenshots older than this will be automatically deleted"
                                       Classes="caption"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding RetentionDays}"
                                       Minimum="1"
                                       Maximum="365"
                                       Width="120"
                                       CornerRadius="8"/>
                    </Grid>
                    
                    <!-- Compress Screenshots -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Compress Screenshots"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Save disk space by compressing stored images"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding CompressScreenshots}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- NOTIFICATIONS SECTION -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="20">
                    <!-- Section Header -->
                    <StackPanel>
                        <TextBlock Text="Notifications" 
                                   Classes="heading2"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Configure notification preferences"
                                   Classes="caption"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Notify on Screenshot Capture"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Show notification when a screenshot is captured"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding NotifyOnCapture}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Notify on New Application"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Alert when a new application starts running"
                                       Classes="caption"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsChecked="{Binding NotifyOnNewApp}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <!-- ACTION BUTTONS -->
            <!-- ═══════════════════════════════════════════════════════════════════════ -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,32">
                <Button Grid.Column="1"
                        Content="Reset to Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        Classes="secondary"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Margin="0,0,12,0"/>
                <Button Grid.Column="2"
                        Command="{Binding SaveSettingsCommand}"
                        Classes="primary">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="16" Height="16">
                            <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                                  Fill="White"
                                  Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Save Settings"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>

</UserControl>
