<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:timetrace.ui.avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="timetrace.ui.avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/timeTrace.ico"
        Title="TimeTrace - Process Monitor"
        MinWidth="900"
        MinHeight="600"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR - Always dark, clean minimal design -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{StaticResource SidebarBackgroundBrush}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            
            <Grid RowDefinitions="Auto,*,Auto">
                
                <!-- App Title -->
                <StackPanel Grid.Row="0" Margin="16,24,16,32">
                    <TextBlock Text="Process Monitor" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SidebarTextBrush}"
                               IsVisible="{Binding !IsCollapsed}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="PM" 
                               FontSize="20" 
                               FontWeight="Bold"
                               Foreground="{StaticResource SidebarTextBrush}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding IsCollapsed}"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="8,0">
                    
                    <!-- Running Processes Button -->
                    <Button Command="{Binding NavigateToApplicationsCommand}"
                            Classes="sidebarNav"
                            Classes.selected="{Binding IsApplicationsSelected}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v12h16V6H4zm2 2h4v2H6V8zm6 0h6v2h-6V8zm-6 4h4v2H6v-2zm6 0h6v2h-6v-2z"
                                      Fill="{StaticResource SidebarTextBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" 
                                       Text="Running Processes" 
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsCollapsed}"/>
                        </Grid>
                    </Button>
                    
                    <!-- Settings Button -->
                    <Button Command="{Binding NavigateToSettingsCommand}"
                            Classes="sidebarNav"
                            Classes.selected="{Binding IsSettingsSelected}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Viewbox Width="20" Height="20" Margin="0,0,12,0">
                                <Path Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z"
                                      Fill="{StaticResource SidebarTextBrush}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" 
                                       Text="Settings" 
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsCollapsed}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Section: Collapse Toggle & Version -->
                <StackPanel Grid.Row="2" Margin="8,16,8,16">
                    
                    <!-- Collapse Button (circular, positioned at edge) -->
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            Margin="0,0,-22,8"
                            Padding="0"
                            CornerRadius="14"
                            Background="{StaticResource SidebarHoverBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Viewbox Width="14" Height="14">
                            <Path Data="{Binding CollapseIconPath}"
                                  Fill="{StaticResource SidebarTextBrush}"
                                  Stretch="Uniform"/>
                        </Viewbox>
                    </Button>
                    
                    <!-- Version -->
                    <TextBlock Text="TimeTrace v1.0.0-alpha" 
                               FontSize="11"
                               Foreground="{StaticResource SidebarTextMutedBrush}"
                               HorizontalAlignment="Left"
                               Margin="8,0,0,0"
                               IsVisible="{Binding !IsCollapsed}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT AREA - Light background with themed content -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" 
                Background="{DynamicResource ContentBackgroundBrush}"
                ClipToBounds="True">
            <ContentControl Content="{Binding CurrentView}" Margin="32,24">
                <ContentControl.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    </Transitions>
                </ContentControl.Transitions>
            </ContentControl>
        </Border>
    </Grid>

</Window>
