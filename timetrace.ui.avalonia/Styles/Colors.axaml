<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 
    TimeTrace Color Palette - Modern Minimal Design
    Based on Figma wireframes: dark sidebar + light content area
    Clean, professional look with proper light/dark mode support
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- SIDEBAR COLORS (Always dark regardless of theme) -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Sidebar.Background">#1F2937</Color>
    <Color x:Key="Sidebar.BackgroundAlt">#111827</Color>
    <Color x:Key="Sidebar.Text">#F9FAFB</Color>
    <Color x:Key="Sidebar.TextMuted">#9CA3AF</Color>
    <Color x:Key="Sidebar.Border">#374151</Color>
    <Color x:Key="Sidebar.Hover">#374151</Color>
    
    <!-- Sidebar Brushes -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource Sidebar.Background}"/>
    <SolidColorBrush x:Key="SidebarBackgroundAltBrush" Color="{StaticResource Sidebar.BackgroundAlt}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource Sidebar.Text}"/>
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="{StaticResource Sidebar.TextMuted}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource Sidebar.Border}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource Sidebar.Hover}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- ACCENT / BRAND COLORS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Accent.Primary">#3B82F6</Color>
    <Color x:Key="Accent.PrimaryHover">#2563EB</Color>
    <Color x:Key="Accent.PrimaryLight">#DBEAFE</Color>
    
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource Accent.Primary}"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource Accent.PrimaryHover}"/>
    <SolidColorBrush x:Key="AccentPrimaryLightBrush" Color="{StaticResource Accent.PrimaryLight}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- STATUS COLORS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Status.Running">#22C55E</Color>
    <Color x:Key="Status.RunningBackground">#DCFCE7</Color>
    <Color x:Key="Status.Idle">#6B7280</Color>
    <Color x:Key="Status.IdleBackground">#F3F4F6</Color>
    <Color x:Key="Status.Error">#EF4444</Color>
    <Color x:Key="Status.ErrorBackground">#FEE2E2</Color>
    <Color x:Key="Status.Warning">#F59E0B</Color>
    <Color x:Key="Status.WarningBackground">#FEF3C7</Color>

    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource Status.Running}"/>
    <SolidColorBrush x:Key="StatusRunningBackgroundBrush" Color="{StaticResource Status.RunningBackground}"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="{StaticResource Status.Idle}"/>
    <SolidColorBrush x:Key="StatusIdleBackgroundBrush" Color="{StaticResource Status.IdleBackground}"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource Status.Error}"/>
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="{StaticResource Status.ErrorBackground}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource Status.Warning}"/>
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="{StaticResource Status.WarningBackground}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- LIGHT THEME - Content Area Colors -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Light.Content.Background">#F4F4F5</Color>
    <Color x:Key="Light.Card.Background">#FFFFFF</Color>
    <Color x:Key="Light.Card.Border">#E4E4E7</Color>
    <Color x:Key="Light.Card.BorderHover">#D4D4D8</Color>
    <Color x:Key="Light.Text.Primary">#18181B</Color>
    <Color x:Key="Light.Text.Secondary">#52525B</Color>
    <Color x:Key="Light.Text.Muted">#A1A1AA</Color>
    <Color x:Key="Light.Divider">#E4E4E7</Color>
    <Color x:Key="Light.Input.Background">#FFFFFF</Color>
    <Color x:Key="Light.Input.Border">#D4D4D8</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- DARK THEME - Content Area Colors -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="Dark.Content.Background">#09090B</Color>
    <Color x:Key="Dark.Card.Background">#18181B</Color>
    <Color x:Key="Dark.Card.Border">#27272A</Color>
    <Color x:Key="Dark.Card.BorderHover">#3F3F46</Color>
    <Color x:Key="Dark.Text.Primary">#FAFAFA</Color>
    <Color x:Key="Dark.Text.Secondary">#A1A1AA</Color>
    <Color x:Key="Dark.Text.Muted">#71717A</Color>
    <Color x:Key="Dark.Divider">#27272A</Color>
    <Color x:Key="Dark.Input.Background">#18181B</Color>
    <Color x:Key="Dark.Input.Border">#3F3F46</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- THEME-AWARE BRUSHES (Switch based on Light/Dark) -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    
    <!-- These need to be defined in theme dictionaries for proper switching -->
    <!-- Default to Light theme values, override in ThemeVariants -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- SHADOWS & EFFECTS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <BoxShadows x:Key="CardShadow">0 1 3 0 #10000000, 0 1 2 -1 #10000000</BoxShadows>
    <BoxShadows x:Key="CardShadowHover">0 10 15 -3 #10000000, 0 4 6 -4 #10000000</BoxShadows>
    <BoxShadows x:Key="DropdownShadow">0 10 15 -3 #20000000, 0 4 6 -4 #20000000</BoxShadows>
    <BoxShadows x:Key="ModalShadow">0 25 50 -12 #25000000</BoxShadows>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- CORNER RADIUS -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- SPACING -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">16</x:Double>
    <x:Double x:Key="SpacingLG">24</x:Double>
    <x:Double x:Key="SpacingXL">32</x:Double>

</ResourceDictionary>
