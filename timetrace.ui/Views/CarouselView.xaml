<UserControl x:Class="timetrace.ui.Views.CarouselView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:timetrace.ui.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Focusable="True">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding PreviousImageCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextImageCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <!-- Main content (visible when images exist) -->
        <Grid Visibility="{Binding FilteredImageCount, Converter={StaticResource IntToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Main Image Area -->
            <Border Grid.Row="0"
                    Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                    CornerRadius="8" Margin="12,12,12,4">
                <Grid>
                    <!-- Image + Placeholder -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="60,40">
                        <Image Source="{Binding CurrentImage.ImageSource}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <!-- Placeholder when no image loaded -->
                        <TextBlock Text="📷" FontSize="64"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.4"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   Visibility="{Binding CurrentImage.ImageSource, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=True}"/>
                    </Grid>

                    <!-- Previous Button (left) -->
                    <Button Command="{Binding PreviousImageCommand}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="12,0,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Width="44" Height="44"
                                        CornerRadius="22" Opacity="0.6"
                                        Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                    <TextBlock Text="◀" FontSize="18"
                                               Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Next Button (right) -->
                    <Button Command="{Binding NextImageCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Width="44" Height="44"
                                        CornerRadius="22" Opacity="0.6"
                                        Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                                    <TextBlock Text="▶" FontSize="18"
                                               Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Counter Pill (top center) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,12,0,0" Padding="14,6"
                            CornerRadius="14" Opacity="0.8"
                            Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                        <TextBlock Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                   FontSize="12">
                            <Run Text="{Binding CarouselCounter, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding CurrentImage.ScreenshotName, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Timestamp Badge (bottom right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,12" Padding="10,5"
                            CornerRadius="10" Opacity="0.7"
                            Background="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                        <TextBlock Text="{Binding CurrentImage.Timestamp, StringFormat='{}{0:MMM dd, yyyy HH:mm:ss}'}"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 1: Thumbnail Strip -->
            <Border Grid.Row="1" Margin="12,4" Padding="4">
                <ListBox ItemsSource="{Binding FilteredImages}"
                         SelectedIndex="{Binding CurrentIndex, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Height="80">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="96" Height="64" CornerRadius="4"
                                    Margin="3,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="📷" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.4"/>
                                    <Image Source="{Binding ImageSource}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                CornerRadius="5" Margin="2" Opacity="0.6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                                <Setter TargetName="ItemBorder" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Row 2: Range Slider -->
            <Border Grid.Row="2" Margin="12,0,12,12" Padding="8,4">
                <Slider Minimum="0"
                        Maximum="{Binding FilteredImageCount}"
                        Value="{Binding CurrentIndex, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        SmallChange="1" LargeChange="1"/>
            </Border>
        </Grid>

        <!-- Empty State (visible when no images) -->
        <Border Visibility="{Binding FilteredImageCount, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=True}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center"
                           Opacity="0.5" Margin="0,0,0,12"/>
                <TextBlock Text="No screenshots found" FontSize="18"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           Opacity="0.6"/>
                <TextBlock Text="Adjust your filter settings or capture new screenshots."
                           FontSize="13" HorizontalAlignment="Center"
                           Opacity="0.5" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
