<UserControl x:Class="timetrace.ui.Views.ApplicationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:timetrace.ui.Views"
             xmlns:vm="clr-namespace:timetrace.ui.ViewModels"
             xmlns:converters="clr-namespace:timetrace.ui.Converters"
             xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             helpers:ViewLocator.ViewModel="ApplicationListViewModel">
    <Grid>
        <Grid.Resources>
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        </Grid.Resources>
        <StackPanel Margin="16">
            <TextBlock Text="Captured Applications"
                       FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16"/>
            <TextBlock Text="Click on any application to view its captured images."
                       Foreground="#666" FontSize="12" Margin="0,0,0,24"/>
            <ListView ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,0,0,12"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon or Emoji -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding IconPath}"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>
                                <!-- Info Section -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ProcessName}"
                                               FontWeight="SemiBold"
                                               FontSize="16"/>
                                    <TextBlock Text="{Binding Status}" 
                                               FontSize="12"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                    <TextBlock Text="{Binding LastCaptured, StringFormat='Last captured: {0:t}'}"
                                               FontSize="10"
                                               Foreground="#666"/>
                                </StackPanel>
                                <!-- Stats Section -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CaptureCount, StringFormat='Captures: {0}'}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}"
                                               FontSize="10"
                                               Foreground="#888"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.Style>
            </ListView>
            <Button Content="Refresh"
                    Command="{Binding RefreshApplicationsCommand}"
                    Width="100"
                    Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
