<Window x:Class="timetrace.ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:timetrace.ui.Views"
        xmlns:viewmodels="clr-namespace:timetrace.ui.ViewModels"
        xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
        mc:Ignorable="d"
        Title="Application Monitor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        helpers:ViewLocator.ViewModel="MainViewModel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="App Monitor" FontSize="20" FontWeight="Bold" 
                           Foreground="#333" Margin="0,0,0,32"/>

                <Button Content="📱 Applications" 
                        Command="{Binding NavigateToApplicationsCommand}"
                        Style="{DynamicResource NavigationButtonStyle}"
                        Margin="0,0,0,8"/>

                <Button Content="⚙️ Settings" 
                        Command="{Binding NavigateToSettingsCommand}"
                        Style="{DynamicResource NavigationButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="White">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="{Binding CurrentViewTitle}" 
                           FontSize="28" FontWeight="Light" 
                           Foreground="#333" Margin="0,0,0,24"/>

                <!-- Dynamic Content -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationListViewModel}">
            <local:ApplicationListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PresenterViewModel}">
            <local:PresenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FilterViewModel}">
            <local:FilterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationDetailsViewModel}">
            <local:ApplicationDetailsView />
        </DataTemplate>

        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>

