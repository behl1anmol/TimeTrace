<Window x:Class="timetrace.ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:timetrace.ui.Views"
        xmlns:viewmodels="clr-namespace:timetrace.ui.ViewModels"
        xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
        mc:Ignorable="d"
        Title="Application Monitor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        helpers:ViewLocator.ViewModel="MainViewModel">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <Button Content="📱 Applications" 
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="Hand"
                        BorderThickness="0"
                        Command="{Binding NavigateToApplicationsCommand}"/>

                <Button Content="⚙️ Settings"
                        HorizontalContentAlignment="Left"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="Hand"
                        BorderThickness="0"
                        Command="{Binding NavigateToSettingsCommand}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="{Binding CurrentViewTitle}" 
                           FontSize="40" FontWeight="Bold" 
                           Margin="0,0,0,24"/>

                <!-- Dynamic Content -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationListViewModel}">
            <local:ApplicationListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PresenterViewModel}">
            <local:PresenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FilterViewModel}">
            <local:FilterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationDetailsViewModel}">
            <local:ApplicationDetailsView />
        </DataTemplate>

    </Window.Resources>
</Window>

