<Window x:Class="timetrace.ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:timetrace.ui.Views"
        xmlns:viewmodels="clr-namespace:timetrace.ui.ViewModels"
        xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
        xmlns:converters="clr-namespace:timetrace.ui.Converters"
        mc:Ignorable="d"
        Title="Application Monitor" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        helpers:ViewLocator.ViewModel="MainViewModel">

    <Window.Resources>
        <converters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" 
                                                CollapsedWidth="90" 
                                                ExpandedWidth="250"/>
        
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <local:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationListViewModel}">
            <local:ApplicationListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PresenterViewModel}">
            <local:PresenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FilterViewModel}">
            <local:FilterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ApplicationDetailsViewModel}">
            <local:ApplicationDetailsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsCollapsed, Converter={StaticResource BooleanToGridLengthConverter}}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation Sidebar -->
        <local:NavigationSidebar Grid.Column="0" DataContext="{Binding}"/>

        <!-- Main Content Area -->
        <Border Grid.Column="1">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="{Binding CurrentViewTitle}" 
                           FontSize="40" FontWeight="Bold" 
                           Margin="0,0,0,24"/>

                <!-- Dynamic Content -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Border>
    </Grid>
</Window>

