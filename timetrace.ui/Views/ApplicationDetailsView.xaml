<UserControl x:Class="timetrace.ui.Views.ApplicationDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:timetrace.ui.Views"
             xmlns:converters="clr-namespace:timetrace.ui.Converters"
             xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             helpers:ViewLocator.ViewModel="ApplicationDetailsViewModel">

    <UserControl.Resources>
        <converters:ViewModeToVisibilityConverter x:Key="ViewModeToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header Bar -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Back Button -->
                <Button Grid.Column="0"
                        Command="{Binding NavigateBackCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" VerticalAlignment="Center"
                        Padding="8,4">
                    <TextBlock Text="← Back" FontSize="14"/>
                </Button>

                <!-- Center: App Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Application.IconPath}"
                               FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Application.ProcessName}"
                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#666">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} of {1} screenshots">
                                <Binding Path="FilteredImageCount"/>
                                <Binding Path="TotalImageCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Right: View Mode Toggle -->
                <Border Grid.Column="2" CornerRadius="6" BorderBrush="#D0D0D0"
                        BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SwitchToCarouselCommand}"
                                Content="Carousel" Padding="12,6"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCarouselMode}" Value="True">
                                            <Setter Property="Background" Value="#E0EDFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SwitchToGridCommand}"
                                Content="Grid" Padding="12,6"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                            <Setter Property="Background" Value="#E0EDFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Row 1: Content Area (Filter + Gallery) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Filter Panel + Stats -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter View -->
                    <local:FilterView Grid.Row="0" DataContext="{Binding FilterViewModel}"/>

                    <!-- Stats Panel -->
                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="#555">
                                <Run Text="Total: "/>
                                <Run Text="{Binding TotalImageCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" screenshots"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#555" Margin="0,4,0,0">
                                <Run Text="Filtered: "/>
                                <Run Text="{Binding FilteredImageCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" results"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 1: Gallery Area (Carousel or Grid) -->
            <Grid Grid.Column="1">
                <local:CarouselView Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=Carousel}"/>
                <local:PresenterView Visibility="{Binding ViewMode, Converter={StaticResource ViewModeToVisibilityConverter}, ConverterParameter=Grid}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
