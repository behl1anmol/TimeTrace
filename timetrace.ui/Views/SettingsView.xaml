<UserControl x:Class="timetrace.ui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:timetrace.ui.Views"
             xmlns:helpers="clr-namespace:timetrace.ui.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             helpers:ViewLocator.ViewModel="SettingsViewModel">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Card title -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Card description -->
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,2,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Setting item label -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Setting item description -->
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <!-- Outline button style -->
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary / accent button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,28,32,32" MaxWidth="800" HorizontalAlignment="Center">

                <!-- ==================== Page Header ==================== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="⚙️" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Configure application capture and monitoring preferences"
                           FontSize="13"
                           Opacity="0.6"
                           Margin="0,0,0,24"/>

                <!-- ==================== Card 1 — Capture Settings ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Capture Settings" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Configure how and when screenshots are captured"
                                   Style="{StaticResource CardDescription}"/>

                        <!-- Separator -->
                        <Separator Margin="0,0,0,14"/>

                        <!-- Automatic Capture -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Automatic Capture" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Automatically capture screenshots at regular intervals"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoCapture}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Capture Interval -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Capture Interval (minutes)" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Time between automatic screenshot captures"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding CaptureIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="80" VerticalAlignment="Center" HorizontalAlignment="Right"
                                     Padding="8,6"/>
                        </Grid>

                        <!-- Screenshot Quality -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Screenshot Quality" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Quality level for captured screenshots"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding QualityOptions}"
                                      SelectedItem="{Binding ScreenshotQuality}"
                                      MinWidth="120" VerticalAlignment="Center" HorizontalAlignment="Right"
                                      Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Card 2 — Monitoring Settings ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Monitoring Settings" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Choose which applications to monitor"
                                   Style="{StaticResource CardDescription}"/>

                        <Separator Margin="0,0,0,14"/>

                        <!-- Monitor All Applications -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Monitor All Applications" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Track activity across all running applications"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding MonitorAll}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Include Background Apps -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Include Background Apps" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Also monitor applications running in the background"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeBackgroundApps}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Include System Apps -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Include System Apps" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Include Windows system processes in monitoring"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeSystemApps}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Card 3 — Storage Settings ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Storage Settings" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Manage screenshot storage and retention"
                                   Style="{StaticResource CardDescription}"/>

                        <Separator Margin="0,0,0,14"/>

                        <!-- Storage Location -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Storage Location" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Directory where screenshots are saved"
                                       Style="{StaticResource SettingDescription}" Margin="0,1,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding StoragePath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" Padding="8,6"/>
                                <Button Grid.Column="1" Content="Browse"
                                        Command="{Binding BrowseStoragePathCommand}"
                                        Margin="8,0,0,0" Padding="14,6"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Retention Period -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Retention Period (days)" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Screenshots older than this will be automatically removed"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="80" VerticalAlignment="Center" HorizontalAlignment="Right"
                                     Padding="8,6"/>
                        </Grid>

                        <!-- Compress Screenshots -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Compress Screenshots" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Reduce file size of stored screenshots"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding CompressScreenshots}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Card 4 — Notifications ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Configure notification preferences"
                                   Style="{StaticResource CardDescription}"/>

                        <Separator Margin="0,0,0,14"/>

                        <!-- Notify on Screenshot Capture -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Notify on Screenshot Capture" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Show a notification each time a screenshot is captured"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnCapture}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Notify on New Application -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Notify on New Application" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Get notified when a new application is detected"
                                           Style="{StaticResource SettingDescription}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnNewApp}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Footer Buttons ==================== -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Reset to Defaults"
                            Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource OutlineButton}"
                            Margin="0,0,12,0"/>
                    <Button Content="Save Settings"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
