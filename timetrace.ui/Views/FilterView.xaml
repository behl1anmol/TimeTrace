<UserControl x:Class="timetrace.ui.Views.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:timetrace.ui.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Filter Options" FontSize="18" FontWeight="SemiBold" 
                       Foreground="#333" Margin="0,0,0,16"/>

            <!-- Date Filter Section -->
            <GroupBox Header="Date Range" Margin="0,0,0,16">
                <StackPanel Margin="8">
                    <TextBlock Text="From Date:" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,0,8"/>

                    <TextBlock Text="To Date:" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,0,16"/>

                    <!-- Calendar View -->
                    <TextBlock Text="Calendar View:" Margin="0,0,0,4"/>
                    <Calendar SelectedDate="{Binding SelectedDate}" 
                              SelectionMode="SingleDate"
                              Margin="0,0,0,8"/>
                </StackPanel>
            </GroupBox>

            <!-- Status Filter -->
            <GroupBox Header="Process Status" Margin="0,0,0,16">
                <StackPanel Margin="8">
                    <CheckBox Content="Active" IsChecked="{Binding ShowActive}" Margin="0,0,0,4"/>
                    <CheckBox Content="Minimized" IsChecked="{Binding ShowMinimized}" Margin="0,0,0,4"/>
                    <CheckBox Content="Closed" IsChecked="{Binding ShowClosed}"/>
                </StackPanel>
            </GroupBox>

            <!-- Filter Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Filter" 
                        Command="{Binding ApplyFilterCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Clear" 
                        Command="{Binding ClearFilterCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
