<UserControl x:Class="timetrace.ui.Views.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:timetrace.ui.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="260"
             Width="260">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Border BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Date Filter" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- FROM date -->
                <TextBlock Text="FROM"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Width="22" Height="22"
                            Padding="0" Margin="6,0,0,0"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Command="{Binding ClearFromDateCommand}"
                            ToolTip="Clear from date"
                            Visibility="{Binding FromDate, Converter={StaticResource NullToVis}}"/>
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"/>
                </DockPanel>

                <!-- TO date -->
                <TextBlock Text="TO"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.6"
                           Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Width="22" Height="22"
                            Padding="0" Margin="6,0,0,0"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Command="{Binding ClearToDateCommand}"
                            ToolTip="Clear to date"
                            Visibility="{Binding ToDate, Converter={StaticResource NullToVis}}"/>
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Apply Filter button -->
                <Button Content="Apply Filter"
                        Command="{Binding ApplyFilterCommand}"
                        Margin="0,4,0,0"
                        Padding="12,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"/>

                <!-- Active filter summary badge -->
                <Border CornerRadius="8"
                        Padding="10"
                        Margin="0,12,0,0"
                        BorderThickness="1"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FilterSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Clear Filters button -->
                <Button Content="Clear Filters"
                        Command="{Binding ClearFilterCommand}"
                        Margin="0,12,0,0"
                        Padding="12,8"
                        FontSize="13"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding HasActiveFilter, Converter={StaticResource BoolToVis}}"/>

                <!-- Stats panel is rendered in ApplicationDetailsView.xaml -->

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
